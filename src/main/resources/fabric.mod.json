{
  "schemaVersion": 1,
  "id": "constantiam-tab",
  "version": "${version}",
  "name": "Constantiam Tab",
  "description": "Tab list for constantiam.net: join dates and play time from /joindate, players who left, friends, join year statistics and a list that fits the screen.",
  "authors": [
    "9733"
  ],
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "dev.constantiamtab.ConstantiamTabAddon"
    ]
  },
  "mixins": [
    "constantiam-tab.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "255,170,40",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${mc_version}"],
    "meteor-client": "*"
  }
}
